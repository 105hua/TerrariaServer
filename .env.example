# Copy this file to .env and change what you need. Every setting is optional.

# --- Version -------------------------------------------------------------------
# "latest", or a release number such as 1449 (also accepted: 1.4.4.9).
# Changing this and running `docker compose up -d` builds that version automatically.
# Worlds can be moved to newer versions but never back to older ones.
TERRARIA_VERSION=latest

# --- Server --------------------------------------------------------------------
# Leave empty for no password.
SERVER_PASSWORD=
# Port on this machine that players connect to.
SERVER_PORT=7777
MAX_PLAYERS=8
MOTD=

# --- World ---------------------------------------------------------------------
# The world loaded from data/worlds/<WORLD_NAME>.wld. If it doesn't exist and
# data/worlds/ holds exactly one other world, that one is used instead; if there
# are no worlds, a new one is created with the settings below.
WORLD_NAME=world
# small | medium | large
WORLD_SIZE=medium
# classic | expert | master | journey
WORLD_DIFFICULTY=classic
# Optional; random if empty.
WORLD_SEED=

# --- File ownership (Linux hosts) ----------------------------------------------
# User/group IDs that own the files in ./data. Set these to the output of
# `id -u` and `id -g` if yours aren't 1000.
PUID=1000
PGID=1000
